#!/bin/sh
#
# Confirm current MBR boot slice as the permanent boot0 default.
#
# updatep1.mbr / updatep2.mbr use `boot0cfg -o noupdate` (try-once):
# the new slice is attempted once.  This script runs on a successful boot
# and calls `-o update` to make the slice the persisted default.
# If the new slice crashes before this script runs, the next reboot still
# tries the same slice; the operator must manually select a working slice
# via the boot0 F1/F2 menu or `boot0cfg -s N /dev/<disk>`.
#
# PROVIDE: boot0confirm
# REQUIRE: FILESYSTEMS
# KEYWORD: nojail

name="boot0confirm"
rcvar="boot0confirm_enable"
start_cmd="boot0confirm_start"
stop_cmd=":"

. /etc/rc.subr
. /etc/nanobsd.conf

load_rc_config ${name}
: ${boot0confirm_enable:="YES"}

boot0confirm_start()
{
	local slice

	# Determine active slice number from root mount device (e.g. /dev/ada0s2a -> 2)
	slice=$(mount | awk '$3 == "/" { match($1, /s([0-9]+)a$/, a); print a[1]; exit }')
	if [ -z "${slice}" ]; then
		warn "${name}: cannot determine current boot slice"
		return 1
	fi

	boot0cfg -s "${slice}" -o update /dev/${NANO_DRIVE} &&
	    echo "${name}: boot slice ${slice} confirmed as permanent default"
}

run_rc_command "$1"
