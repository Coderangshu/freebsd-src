#
# Script to update partition 1 on a NanoBSD GPT system.
#
# usage:
#	ssh somewhere cat image | sh updatep1
#

set -e

. /etc/nanobsd.conf

if mount | grep -q "/dev/${NANO_DRIVE}1"; then
	echo "You are running partition 1 already"
	echo "you probably want to use 'updatep2' instead"
	exit 1
fi

# Find the physical disk backing the GPT label
NANO_DISK=$(glabel status | awk -v lbl="${NANO_DRIVE}1" \
    '$1 == lbl { sub(/p[0-9]+$/, "", $3); print $3; exit }')
if [ -z "${NANO_DISK}" ]; then
	echo "Cannot find disk for ${NANO_DRIVE}1" >&2
	exit 1
fi

# Blow away old system
dd if=/dev/zero of=/dev/${NANO_DRIVE}1 bs=1m count=1 > /dev/null 2>&1

# Copy in new system
dd of=/dev/${NANO_DRIVE}1 obs=64k

# Check that it worked
fsck_ffs -n /dev/${NANO_DRIVE}1

# Set bootonce: try partition 1 on next boot. /etc/rc.d/gptboot confirms
# on successful boot and clears bootonce; on crash gptboot marks it bootfailed
# and falls back to the other partition automatically.
gpart set -a bootonce -i ${NANO_PART_ROOT_IDX} ${NANO_DISK}
